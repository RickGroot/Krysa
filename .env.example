# Supabase project → Project Settings → API keys. The publishable key
# (sb_publishable_…) is meant to be public; row level security in
# supabase/schema.sql decides who can read and write. A legacy anon key also
# works as VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Only for `pnpm seed`. Never commit or expose this one.
SUPABASE_SECRET_KEY=
